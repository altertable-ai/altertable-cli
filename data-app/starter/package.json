{
  "name": "data-app-starter",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/*",
    "#config": "./app.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "dev": "bun --hot src/server.ts",
    "build": "bun build src/index.html --outdir=dist --production"
  },
  "dependencies": {
    "@altertable/data-app": "0.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  }
}
